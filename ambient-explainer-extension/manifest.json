{
  "manifest_version": 3,
  "name": "JustClarify",
  "version": "0.5.0",
  "description": "Understand anything you highlight — free on-device AI, no account, no setup",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "tabCapture",
    "offscreen"
  ],
  "action": {
    "default_title": "JustClarify — conversations & focus mode",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "host_permissions": [
    "http://localhost:8000/*",
    "https://api.justclarify.xyz/*",
    "https://api.justclarify.ayotomcs.me/*",
    "https://ai-gateway.vercel.sh/*",
    "https://api.dictionaryapi.dev/*",
    "https://factchecktools.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/gsap.min.js", "brand.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/providers/*.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
