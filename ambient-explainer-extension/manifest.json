{
  "manifest_version": 3,
  "name": "JustClarify",
  "version": "0.6.0",
  "description": "Understand anything you highlight — explanations, fact-checks and voice control, no account, no setup",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "tabCapture",
    "offscreen",
    "sessions",
    "history",
    "scripting",
    "tabGroups"
  ],
  "action": {
    "default_title": "JustClarify — conversations & focus mode",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "host_permissions": [
    "<all_urls>",
    "https://justclarify.xyz/*",
    "https://api.justclarify.xyz/*",
    "https://ai-gateway.vercel.sh/*",
    "https://api.dictionaryapi.dev/*",
    "https://factchecktools.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/gsap.min.js",
        "brand.js",
        "content.js",
        "commands.js",
        "voice.js"
      ],
      "css": [
        "styles.css"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "voice-frame.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
