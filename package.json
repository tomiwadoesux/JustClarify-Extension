    "ai": "^7.0.0-canary.176",
    "framer-motion": "^12.34.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.17",
    "next": "16.1.1",
    "p5": "^2.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
