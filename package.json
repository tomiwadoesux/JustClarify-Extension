    "test:e2e": "node ambient-explainer-extension/tests/e2e/llm-harness.mjs",
    "test": "npm run test:voice && npm run test:llm && npm run test:ask && npm run test:popup && npm run test:mic && npm run test:domain && npm run test:providers",
    "test:ask": "node ambient-explainer-extension/tests/ask-settle.mjs",
    "test:e2e:nodom": "NODOM=1 node ambient-explainer-extension/tests/e2e/llm-harness.mjs",
    "test:popup": "node ambient-explainer-extension/tests/popup-place.mjs && node ambient-explainer-extension/tests/popup-keep.mjs && node ambient-explainer-extension/tests/popup-tile.mjs",
    "test:grounding": "node ambient-explainer-extension/tests/grounding.mjs",
    "test:net": "node ambient-explainer-extension/tests/llm-net.mjs",
    "test:mic": "node ambient-explainer-extension/tests/mic-route.mjs",
    "test:domain": "node ambient-explainer-extension/tests/domain-rank.mjs",
    "test:frame": "node ambient-explainer-extension/tests/voice-frame.mjs",
    "test:providers": "node ambient-explainer-extension/tests/providers.mjs"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.0-canary.107",
